{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/workers/payments/reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/workers/notifications/deliver",
      "schedule": "*/5 * * * *"
    }
  ]
}
