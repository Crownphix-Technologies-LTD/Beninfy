// Prisma schema for Beninfy backend
// Models: User, Booking, Vehicle, Route, Tour, Payment
// Auth.js compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  hashedPassword String?
  role           String          @default("user")
  sessionVersion Int             @default(0)
  disabledAt     DateTime?
  bookings       Booking[]
  driver         Driver?
  mobileSessions MobileSession[]
  pushDevices    PushDevice[]
  notifications  Notification[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MobileSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceId         String?
  platform         String?
  deviceName       String?
  appVersion       String?
  revokedAt        DateTime?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id                  String       @id @default(cuid())
  userId              String?
  user                User?        @relation(fields: [userId], references: [id])
  from                String
  to                  String
  date                DateTime
  returnDate          DateTime?
  tripType            String       @default("one_way")
  passengerName       String?
  passengerEmail      String?
  passengerPhone      String?
  passportId          String?
  nationality         String?
  travelers           Json?
  pickupAddress       String?
  dropoffAddress      String?
  specialRequirements String?
  vehicleId           String
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id])
  passengers          Int
  priceNGN            Int
  discountNGN         Int          @default(0)
  couponId            String?
  couponCode          String?
  coupon              Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status              String       @default("pending")
  paymentId           String?
  payments            Payment[]
  legs                BookingLeg[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([vehicleId, date])
  @@index([passengerEmail])
  @@index([createdAt])
}

model Vehicle {
  id              String         @id
  name            String
  nameFr          String?
  capacity        Int
  luggageCapacity Int            @default(0)
  available       Boolean        @default(true)
  image           String?
  description     String?
  descriptionFr   String?
  badge           String?
  badgeFr         String?
  features        String[]       @default([])
  featuresFr      String[]       @default([])
  basePriceNGN    Int?
  bookings        Booking[]
  fleetVehicles   FleetVehicle[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model FleetVehicle {
  id          String         @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  label       String
  plateNumber String         @unique
  color       String?
  status      String         @default("available")
  currentCity String?
  notes       String?
  bookingLegs BookingLeg[]
  blocks      VehicleBlock[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([vehicleId, status, label])
}

model Driver {
  id              String               @id @default(cuid())
  userId          String?              @unique
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  phone           String
  email           String?
  status          String               @default("available")
  homeCity        String?
  licenseNumber   String?
  notes           String?
  bookingLegs     BookingLeg[]
  presence        DriverPresence?
  latestLocations LatestTripLocation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, name])
}

model VehicleBlock {
  id             String       @id @default(cuid())
  fleetVehicleId String
  fleetVehicle   FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([fleetVehicleId, startsAt, endsAt])
}

model BookingLeg {
  id                     String              @id @default(cuid())
  bookingId              String
  booking                Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction              String
  from                   String
  to                     String
  departureDate          DateTime
  vehicleId              String
  fleetVehicleId         String?
  fleetVehicle           FleetVehicle?       @relation(fields: [fleetVehicleId], references: [id])
  driverId               String?
  driver                 Driver?             @relation(fields: [driverId], references: [id])
  status                 String              @default("unassigned")
  assignedAt             DateTime?
  acceptedAt             DateTime?
  declinedAt             DateTime?
  enRouteAt              DateTime?
  arrivedAt              DateTime?
  passengerOnboardAt     DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?
  cancellationReasonCode String?
  declineReasonCode      String?
  notes                  String?
  latestLocation         LatestTripLocation?
  chatConversations      TripConversation[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([bookingId])
  @@index([vehicleId, departureDate])
  @@index([fleetVehicleId, departureDate])
  @@index([fleetVehicleId, status, departureDate])
  @@index([driverId, departureDate])
  @@index([driverId, status, departureDate])
  @@index([status, departureDate])
}

model DriverPresence {
  id                  String    @id @default(cuid())
  driverId            String    @unique
  driver              Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status              String    @default("offline")
  lastSeenAt          DateTime
  lastHeartbeatAt     DateTime?
  currentBookingLegId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, lastSeenAt])
  @@index([currentBookingLegId])
}

model LatestTripLocation {
  id                   String     @id @default(cuid())
  bookingLegId         String     @unique
  bookingLeg           BookingLeg @relation(fields: [bookingLegId], references: [id], onDelete: Cascade)
  driverId             String
  driver               Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude             Float
  longitude            Float
  accuracyMeters       Float?
  headingDegrees       Float?
  speedMetersPerSecond Float?
  sequence             Int?
  capturedAt           DateTime
  receivedAt           DateTime   @default(now())
  expiresAt            DateTime
  sourceSessionId      String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([driverId, receivedAt])
  @@index([expiresAt])
  @@index([bookingLegId, capturedAt])
}

model PushDevice {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appType       String
  principalType String
  platform      String
  token         String
  tokenHash     String
  deviceId      String?
  deviceName    String?
  appVersion    String?
  language      String                 @default("en")
  lastSeenAt    DateTime               @default(now())
  revokedAt     DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deliveries    NotificationDelivery[]

  @@unique([appType, tokenHash])
  @@unique([userId, appType, deviceId])
  @@index([userId, appType, revokedAt, invalidatedAt])
  @@index([appType, principalType, platform])
  @@index([lastSeenAt])
}

model Notification {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appType       String
  type          String
  language      String                 @default("en")
  title         String
  body          String
  payload       Json
  dedupeKey     String                 @unique
  readAt        DateTime?
  deliveryState String                 @default("pending")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deliveries    NotificationDelivery[]

  @@index([userId, appType, createdAt])
  @@index([userId, appType, readAt, createdAt])
  @@index([deliveryState, createdAt])
  @@index([type, createdAt])
}

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushDeviceId      String?
  pushDevice        PushDevice?  @relation(fields: [pushDeviceId], references: [id], onDelete: SetNull)
  provider          String
  status            String       @default("pending")
  attempts          Int          @default(0)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  providerMessageId String?
  errorCode         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([notificationId, pushDeviceId])
  @@index([notificationId])
  @@index([pushDeviceId])
  @@index([status, nextAttemptAt])
}

model TripConversation {
  id                 String        @id @default(cuid())
  bookingLegId       String
  bookingLeg         BookingLeg    @relation(fields: [bookingLegId], references: [id], onDelete: Cascade)
  customerUserId     String
  driverId           String
  status             String        @default("open")
  closedAt           DateTime?
  closedReason       String?
  customerLastReadAt DateTime?
  driverLastReadAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  messages           ChatMessage[]

  @@unique([bookingLegId, driverId])
  @@index([bookingLegId, status])
  @@index([customerUserId, updatedAt])
  @@index([driverId, updatedAt])
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    TripConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookingLegId    String
  senderType      String
  senderUserId    String?
  senderDriverId  String?
  messageType     String           @default("text")
  text            String?
  systemCode      String?
  clientMessageId String?
  createdAt       DateTime         @default(now())

  @@unique([conversationId, senderType, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([bookingLegId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderDriverId, createdAt])
}

model Route {
  id              String       @id
  from            String
  fromCode        String?
  fromCountry     String?
  to              String
  toCode          String?
  toCountry       String?
  durationHours   Float
  popular         Boolean      @default(false)
  image           String?
  description     String?
  descriptionFr   String?
  borderCrossings String[]     @default([])
  prices          RoutePrice[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model RoutePrice {
  id           String   @id @default(cuid())
  routeId      String
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId    String
  pricingScope String   @default("default")
  amountNGN    Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([routeId, vehicleId, pricingScope])
  @@index([vehicleId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String
  amountNGN      Int?
  percent        Int?
  active         Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  minSpendNGN    Int?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Tour {
  id              String   @id
  title           String
  titleFr         String?
  destination     String?
  destinationFr   String?
  country         String
  countryFr       String?
  durationDays    Int
  startingFromNGN Int
  image           String?
  description     String
  descriptionFr   String?
  highlights      String[] @default([])
  highlightsFr    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BorderFee {
  id              String   @id
  country         String
  countryFr       String?
  border          String
  borderFr        String?
  countries       String[] @default([])
  feePerPersonNGN Int
  feeRoundTripNGN Int
  popular         Boolean  @default(false)
  icon            String?
  services        String[] @default([])
  servicesFr      String[] @default([])
  documents       String[] @default([])
  documentsFr     String[] @default([])
  tips            String[] @default([])
  tipsFr          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id                  String    @id @default(cuid())
  bookingId           String
  amountNGN           Int
  status              String
  reference           String    @unique
  provider            String    @default("payonus")
  providerReference   String?   @unique
  providerCheckoutUrl String?
  providerAccessCode  String?
  currencyCode        String    @default("NGN")
  checkoutAmount      Int?
  expiresAt           DateTime?
  paidAt              DateTime?
  failureCode         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  booking             Booking   @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@index([bookingId, status, createdAt])
}
