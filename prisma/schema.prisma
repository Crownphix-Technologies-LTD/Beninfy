// Prisma schema for Beninfy backend
// Models: User, Booking, Vehicle, Route, Tour, Payment
// Auth.js compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  hashedPassword String?
  role          String   @default("user")
  sessionVersion Int     @default(0)
  disabledAt    DateTime?
  bookings      Booking[]
  driver         Driver?
  mobileSessions MobileSession[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MobileSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  deviceId         String?
  platform         String?
  deviceName       String?
  appVersion       String?
  revokedAt        DateTime?
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  from        String
  to          String
  date        DateTime
  returnDate  DateTime?
  tripType    String   @default("one_way")
  passengerName  String?
  passengerEmail String?
  passengerPhone String?
  passportId     String?
  nationality    String?
  travelers      Json?
  pickupAddress  String?
  dropoffAddress String?
  specialRequirements String?
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  passengers  Int
  priceNGN    Int
  discountNGN Int      @default(0)
  couponId    String?
  couponCode  String?
  coupon      Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status      String   @default("pending")
  paymentId   String?
  payments    Payment[]
  legs        BookingLeg[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([vehicleId, date])
  @@index([passengerEmail])
  @@index([createdAt])
}

model Vehicle {
  id              String   @id
  name            String
  nameFr          String?
  capacity        Int
  luggageCapacity Int      @default(0)
  available       Boolean  @default(true)
  image           String?
  description     String?
  descriptionFr   String?
  badge           String?
  badgeFr         String?
  features        String[] @default([])
  featuresFr      String[] @default([])
  basePriceNGN    Int?
  bookings        Booking[]
  fleetVehicles   FleetVehicle[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FleetVehicle {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  label           String
  plateNumber     String   @unique
  color           String?
  status          String   @default("available")
  currentCity     String?
  notes           String?
  bookingLegs     BookingLeg[]
  blocks          VehicleBlock[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vehicleId, status, label])
}

model Driver {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  phone           String
  email           String?
  status          String   @default("available")
  homeCity        String?
  licenseNumber   String?
  notes           String?
  bookingLegs     BookingLeg[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, name])
}

model VehicleBlock {
  id              String   @id @default(cuid())
  fleetVehicleId  String
  fleetVehicle    FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  reason          String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fleetVehicleId, startsAt, endsAt])
}

model BookingLeg {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction       String
  from            String
  to              String
  departureDate   DateTime
  vehicleId       String
  fleetVehicleId  String?
  fleetVehicle    FleetVehicle? @relation(fields: [fleetVehicleId], references: [id])
  driverId        String?
  driver          Driver? @relation(fields: [driverId], references: [id])
  status          String   @default("unassigned")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingId])
  @@index([vehicleId, departureDate])
  @@index([fleetVehicleId, departureDate])
  @@index([fleetVehicleId, status, departureDate])
  @@index([driverId, departureDate])
  @@index([driverId, status, departureDate])
  @@index([status, departureDate])
}

model Route {
  id              String   @id
  from            String
  fromCode        String?
  fromCountry     String?
  to              String
  toCode          String?
  toCountry       String?
  durationHours   Float
  popular         Boolean  @default(false)
  image           String?
  description     String?
  descriptionFr   String?
  borderCrossings String[] @default([])
  prices          RoutePrice[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RoutePrice {
  id              String   @id @default(cuid())
  routeId         String
  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId       String
  pricingScope    String   @default("default")
  amountNGN       Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([routeId, vehicleId, pricingScope])
  @@index([vehicleId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String
  amountNGN      Int?
  percent        Int?
  active         Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  minSpendNGN    Int?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Tour {
  id              String   @id
  title           String
  titleFr         String?
  destination     String?
  destinationFr   String?
  country         String
  countryFr       String?
  durationDays    Int
  startingFromNGN Int
  image           String?
  description     String
  descriptionFr   String?
  highlights      String[] @default([])
  highlightsFr    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BorderFee {
  id              String   @id
  country         String
  countryFr       String?
  border          String
  borderFr        String?
  countries       String[] @default([])
  feePerPersonNGN Int
  feeRoundTripNGN Int
  popular         Boolean  @default(false)
  icon            String?
  services        String[] @default([])
  servicesFr      String[] @default([])
  documents       String[] @default([])
  documentsFr     String[] @default([])
  tips            String[] @default([])
  tipsFr          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String
  amountNGN         Int
  status            String
  reference         String   @unique
  provider          String   @default("payonus")
  providerReference String?  @unique
  currencyCode      String   @default("NGN")
  checkoutAmount    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
}
